{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@ttsdata/shared": [
        "../../packages/shared/src"
      ],
      "@ttsdata/db": [
        "../../packages/db/src"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}