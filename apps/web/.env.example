# TikTok Display API OAuth (browser-exposed)
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=your-client-key
NEXT_PUBLIC_TIKTOK_REDIRECT_URI=https://ttsdata.netlify.app/api/auth/tiktok/callback

# Server-side only (never exposed to browser)
TIKTOK_CLIENT_SECRET=your-client-secret

# Netlify secrets scan (OAuth client key is public)
SECRETS_SCAN_OMIT_KEYS=NEXT_PUBLIC_TIKTOK_CLIENT_KEY
