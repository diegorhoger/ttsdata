{
  "name": "@ttsdata/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "generate": "drizzle-kit generate",
    "verify:ccos-postgres": "node --import tsx scripts/verify-ccos-postgres.ts",
    "studio": "drizzle-kit studio",
    "migrate:production": "node dist/src/migrate.js"
  },
  "dependencies": {
    "@ttsdata/shared": "workspace:*",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.11.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./src/schema": {
      "types": "./dist/src/schema.d.ts",
      "default": "./dist/src/schema.js"
    },
    "./src/*": {
      "types": "./dist/src/*.d.ts",
      "default": "./dist/src/*.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
